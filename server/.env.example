# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local). Uploaded files are stored
# in this same database via GridFS (bucket "uploads").
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT secret (REQUIRED in production, 16+ random characters). Tokens expire after 7 days.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS. Comma-separated list, or * to allow any.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Contact form e-mail notifications (optional — messages are always saved in the DB)
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Where notifications go (defaults to ADMIN_EMAIL, then EMAIL_USER)
NOTIFICATION_RECEIVER_EMAIL=

# ---------------------------------------------------------------------------
# Initial admin account — used by `npm run seed` ONLY when no admin exists yet.
# Change the password later from /admin/account.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe123

# ---------------------------------------------------------------------------
# Upload limits (files are stored in MongoDB GridFS; images auto-converted to WebP)
# ---------------------------------------------------------------------------
MAX_IMAGE_MB=5
MAX_PDF_MB=10
